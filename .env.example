# Copy to .env.local for local development. Set these in Vercel for production.
# Canonical public origin, with https and no trailing path. Required for correct SEO.
NEXT_PUBLIC_SITE_URL=

# Resend: verify your sending domain before using a production From address.
RESEND_API_KEY=
ENQUIRY_FROM=
ENQUIRY_TO=

# Upstash Redis REST credentials: REQUIRED in production for shared rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=
